# Configuración para Docker Compose Build
# Copia este archivo a .env y ajusta los valores según tus necesidades

# IP del servidor C2 (donde se conectará el agente)
# Usa tu IP pública si vas a desplegar en Internet
# Usa tu IP local (192.168.x.x) para red local
SERVER_IP=127.0.0.1

# Puerto del servidor C2
SERVER_PORT=4444

# Nombre del agente generado (sin extensión .exe)
AGENT_NAME=agent

# Modo de compilación del agente
# false = Modo desarrollo (con consola y debug prints)
# true = Modo producción (stealthy, sin consola, sin debug)
PRODUCTION_MODE=false
